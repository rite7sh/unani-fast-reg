# Copy to .env for local development. Never commit the real .env file.

# Port the API listens on.
PORT=4000

# Network interface to listen on. Default (0.0.0.0) accepts connections
# from other machines on the same network — needed for a hospital LAN
# deployment where this server runs on one PC (e.g. the Admin PC) and is
# reached from another (e.g. an Operator PC) at this machine's LAN IP.
# Leave unset unless you specifically need to restrict this to
# 127.0.0.1 (localhost-only, e.g. a single-machine dev setup).
# HOST=0.0.0.0

# Shared setup token required to register (pair) a new device. Treat this
# like a password — only share it with machines you actually want to grant
# upload access to. Generate a long random value for anything beyond local
# testing, e.g.: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DEVICE_SETUP_TOKEN=local-dev-setup-token

# Where uploaded backup files are stored WHEN R2 is not configured (see
# below) — local disk, only appropriate for development/testing. Ignored
# once all four R2_* variables below are set.
STORAGE_DIR=./data/storage

# Where the server's own small metadata database (devices, backup records,
# the patient_sync mirror — never a copy of the desktop app's own SQLite
# file) lives. This needs to be on real persistent storage in production —
# see the deployment plan for why an ephemeral container filesystem is not
# acceptable here.
DB_PATH=./data/server.db

# ---- Cloudflare R2 (production backup storage) ----
# Leave all four blank for local development — the server falls back to
# STORAGE_DIR above. In production, set all four together; the server
# refuses to start if only some are set, rather than silently falling back
# to local disk. Get these from the Cloudflare dashboard: R2 > Manage R2
# API Tokens (scope the token to only this one bucket, read+write).
# Never commit real values here — this file is a template, not the real
# .env (which is gitignored).
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
