{
  "name": "unani-opd",
  "version": "1.0.0",
  "description": "Unani Hospital OPD Management System — desktop patient registration and reporting application",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "electron .",
    "build": "npm run build:vite && npm run build:electron",
    "build:vite": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json && tsc -p electron/preload.tsconfig.json && tsc -p electron/database.tsconfig.json && node --input-type=module -e \"import fs from 'fs'; fs.renameSync('dist-electron/preload.js', 'dist-electron/preload.cjs'); fs.renameSync('dist-electron/database.js', 'dist-electron/database.cjs');\"",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "rebuild:server": "node scripts/rebuild-server-native.cjs",
    "dist:win": "npm run rebuild:server && electron-builder --win"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^9.32.0",
    "@types/electron": "^1.6.10",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.2.0",
    "wait-on": "^8.0.1"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "better-sqlite3@12.11.1": true
  },
  "build": {
    "appId": "com.unanihospital.opd",
    "productName": "Unani Hospital OPD Management System",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*.js",
      "dist-electron/**/*.cjs",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "extraResources": [
      { "from": "server/dist", "to": "server/dist" },
      { "from": "server/package.json", "to": "server/package.json" },
      {
        "from": "server/node_modules",
        "to": "server/node_modules",
        "filter": ["**/*", "!typescript/**", "!tsx/**", "!@types/**", "!.bin/**"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/unani-logo.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Unani Hospital OPD"
    }
  }
}
